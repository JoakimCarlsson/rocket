# Everything the image does not need is dropped here, so a `docker build` does
# not ship a local checkout's caches or state.

.git
.github

# Build output and caches.
bin/
*.exe
tmp/
web/node_modules/
web/.next/
web/out/
*.tsbuildinfo
web/next-env.d.ts

# Local state and secrets.
.env

# Not needed to compile or serve.
*.md
